# Regenerable build products.  Keep the per-unit JSON evidence (unit.json,
# run.json, coverage.json, build.json, stderr) because that is the run record.
runs/*/build/
runs/*/cases/**/build/obj/
runs/*/cases/**/*.exe
runs/*/cases/**/*.o
runs/*/cases/**/*.gcda
runs/*/cases/**/*.gcno
runs/*/cases/**/*.gcov.json.gz
__pycache__/
*.py[cod]
