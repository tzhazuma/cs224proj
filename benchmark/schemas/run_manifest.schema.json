{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs224.local/benchmark/schemas/run_manifest.schema.json",
  "title": "Unified benchmark run manifest",
  "description": "One manifest per immutable run directory. Version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "protocol_version",
    "tier",
    "track",
    "dataset",
    "method",
    "execution",
    "artifacts",
    "hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "benchmark-run-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "tier": {
      "enum": [
        "A",
        "B"
      ]
    },
    "track": {
      "enum": [
        "secvuleval",
        "juliet_cwe401"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "enum": [
          "detection",
          "pair_detection",
          "leak_detection",
          "repair"
        ]
      },
      "uniqueItems": true
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "split_id",
        "path",
        "sha256",
        "unit_count"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "split_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "unit_manifest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "label_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "group_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "family",
        "name"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "family": {
          "enum": [
            "llm",
            "static",
            "dynamic",
            "hybrid"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "model_id",
                "family",
                "provider"
              ],
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "endpoint": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "context_window": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "tokenizer": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "decoding": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "price_snapshot": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "tool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "command_template": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "license": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "status",
        "planned_units",
        "recorded_units"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "partial",
            "failed"
          ]
        },
        "planned_units": {
          "type": "integer",
          "minimum": 0
        },
        "recorded_units": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "command_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment": {
          "type": "object"
        },
        "planned_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predictions"
      ],
      "properties": {
        "predictions": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation": {
          "type": [
            "string",
            "null"
          ]
        },
        "log": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "legacy_import": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source_run_dir",
            "source_results_sha256",
            "conversion_tool"
          ],
          "properties": {
            "source_run_dir": {
              "type": "string",
              "minLength": 1
            },
            "source_results_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "conversion_tool": {
              "type": "string",
              "minLength": 1
            },
            "derived_not_rerun": {
              "const": true
            },
            "repair_records_omitted": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
