{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs224.local/benchmark/schemas/metrics.schema.json",
  "title": "Unified benchmark metrics",
  "description": "Computed metrics for one run. Metrics are null when undefined; failures and coverage are reported separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "protocol_version",
    "tier",
    "track",
    "generated_at",
    "tasks",
    "cost",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": "benchmark-metrics-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "A",
        "B"
      ]
    },
    "track": {
      "enum": [
        "secvuleval",
        "juliet_cwe401"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 0
        },
        "bootstrap_seed": {
          "type": "integer"
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "cluster_unit": {
          "type": "string"
        },
        "strict_policy": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "detection": {
          "$ref": "#/$defs/detection_block"
        },
        "leak_detection": {
          "$ref": "#/$defs/leak_block"
        },
        "pair_detection": {
          "$ref": "#/$defs/pair_block"
        },
        "repair": {
          "type": "object",
          "additionalProperties": true,
          "description": "Repair is not scored for correctness by v1; counts only."
        }
      }
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "planned_units",
        "by_task",
        "by_status"
      ],
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "planned_units": {
          "type": "integer",
          "minimum": 0
        },
        "by_task": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "missing_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "number_or_null": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "wilson": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "successes",
            "total",
            "estimate",
            "low",
            "high",
            "confidence",
            "method"
          ],
          "properties": {
            "successes": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "estimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "method": {
              "const": "wilson"
            }
          }
        }
      ]
    },
    "bootstrap_metric": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "ci_low",
            "ci_high",
            "valid_resamples",
            "resamples",
            "unstable"
          ],
          "properties": {
            "ci_low": {
              "type": [
                "number",
                "null"
              ]
            },
            "ci_high": {
              "type": [
                "number",
                "null"
              ]
            },
            "bootstrap_median": {
              "type": [
                "number",
                "null"
              ]
            },
            "bootstrap_mean": {
              "type": [
                "number",
                "null"
              ]
            },
            "valid_resamples": {
              "type": "integer",
              "minimum": 0
            },
            "resamples": {
              "type": "integer",
              "minimum": 0
            },
            "unstable": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "detection_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "valid",
        "invalid",
        "coverage",
        "confusion",
        "precision",
        "recall",
        "specificity",
        "f1",
        "macro_f1",
        "balanced_accuracy",
        "accuracy",
        "strict_accuracy",
        "mcc"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "$ref": "#/$defs/number_or_null"
        },
        "invalid_rate": {
          "$ref": "#/$defs/number_or_null"
        },
        "confusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tp",
            "fp",
            "tn",
            "fn"
          ],
          "properties": {
            "tp": {
              "type": "integer",
              "minimum": 0
            },
            "fp": {
              "type": "integer",
              "minimum": 0
            },
            "tn": {
              "type": "integer",
              "minimum": 0
            },
            "fn": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "precision": {
          "$ref": "#/$defs/number_or_null"
        },
        "recall": {
          "$ref": "#/$defs/number_or_null"
        },
        "specificity": {
          "$ref": "#/$defs/number_or_null"
        },
        "f1": {
          "$ref": "#/$defs/number_or_null"
        },
        "negative_f1": {
          "$ref": "#/$defs/number_or_null"
        },
        "macro_f1": {
          "$ref": "#/$defs/number_or_null"
        },
        "balanced_accuracy": {
          "$ref": "#/$defs/number_or_null"
        },
        "accuracy": {
          "$ref": "#/$defs/number_or_null"
        },
        "strict_accuracy": {
          "$ref": "#/$defs/number_or_null"
        },
        "mcc": {
          "$ref": "#/$defs/number_or_null"
        },
        "mcc_degenerate": {
          "type": "boolean"
        },
        "predicted_positive_rate": {
          "$ref": "#/$defs/number_or_null"
        },
        "label_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "undefined_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wilson": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/wilson"
          }
        }
      }
    },
    "detection_block": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scores",
        "bootstrap"
      ],
      "properties": {
        "scores": {
          "$ref": "#/$defs/detection_scores"
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bootstrap_metric"
          }
        },
        "cluster_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "pair_block": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "n_pairs",
        "valid_pairs",
        "invalid_pairs",
        "coverage",
        "joint_accuracy_valid_pairs",
        "joint_accuracy_all_pairs",
        "joint_categories"
      ],
      "properties": {
        "n_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "valid_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "missing_pairs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "coverage": {
          "$ref": "#/$defs/number_or_null"
        },
        "invalid_rate": {
          "$ref": "#/$defs/number_or_null"
        },
        "joint_correct_valid_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "joint_correct_all_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "joint_accuracy_valid_pairs": {
          "$ref": "#/$defs/number_or_null"
        },
        "joint_accuracy_all_pairs": {
          "$ref": "#/$defs/number_or_null"
        },
        "joint_categories": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "joint_rates_valid_pairs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/number_or_null"
          }
        },
        "consistent_rate": {
          "$ref": "#/$defs/number_or_null"
        },
        "swapped_rate": {
          "$ref": "#/$defs/number_or_null"
        },
        "wilson": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/wilson"
          }
        }
      }
    },
    "leak_block": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "detection",
        "coverage_strata",
        "inconclusive"
      ],
      "properties": {
        "detection": {
          "$ref": "#/$defs/detection_block"
        },
        "coverage_strata": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/detection_scores"
              }
            ]
          }
        },
        "inconclusive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "policy"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "policy": {
              "type": "string"
            },
            "strict_treated_as": {
              "type": "string"
            },
            "coverage_inconclusive": {
              "type": "integer",
              "minimum": 0
            },
            "coverage_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "oracle_consistency": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "currency",
        "usd_known_sum",
        "usd_unknown_records",
        "usd_complete"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "usd_known_sum": {
          "type": [
            "number",
            "null"
          ]
        },
        "usd_unknown_records": {
          "type": "integer",
          "minimum": 0
        },
        "usd_complete": {
          "type": "boolean"
        },
        "wall_s_sum": {
          "type": [
            "number",
            "null"
          ]
        },
        "cpu_s_sum": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_rss_mb_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "prompt_tokens_sum": {
          "type": [
            "integer",
            "null"
          ]
        },
        "completion_tokens_sum": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cached_prompt_tokens_sum": {
          "type": [
            "integer",
            "null"
          ]
        },
        "latency_ms_p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "latency_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "cost_per_100_units_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "cost_per_true_positive_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "wall_s_per_100_units": {
          "type": [
            "number",
            "null"
          ]
        },
        "cost_basis_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
