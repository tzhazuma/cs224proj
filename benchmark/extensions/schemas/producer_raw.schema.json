            "integer",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "object",
            "null"
          ]
        },
        "usage": {
          "type": [
            "object",
            "null"
          ]
        },
        "cost": {
          "type": [
            "object",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
