{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs224.local/benchmark/extensions/schemas/claim_manifest.schema.json",
  "title": "Frozen evidence-verification claim manifest",
  "description": "Gold claims for the evidence_verification design. The manifest is frozen before test evaluation. Each claim is one evaluation unit; claims must be constructed by the pre-registered rule and must not expose model-under-test outputs or dataset labels in the verifier prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "split_id",
    "created_at",
    "frozen",
    "construction_rule",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "benchmark-evidence-claims-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "frozen": {"const": true},
    "construction_rule": {"type": "string", "minLength": 20},
    "label_source": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "tier",
          "track",
          "split",
          "source_unit_id",
          "cluster_id",
          "gold_verdict",
          "claim_type",
          "claim_text",
          "claim_text_sha256",
          "source_sha256"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1, "maxLength": 300},
          "tier": {"enum": ["A", "B"]},
          "track": {"enum": ["secvuleval", "juliet_cwe401"]},
          "split": {"type": "string", "minLength": 1},
          "source_unit_id": {"type": "string", "minLength": 1, "maxLength": 300},
          "cluster_id": {"type": "string", "minLength": 1, "maxLength": 300},
          "gold_verdict": {"enum": ["supported", "unsupported"]},
          "claim_type": {"enum": ["genuine", "counterfactual", "perturbed", "other"]},
          "claim_text": {"type": "string", "minLength": 1},
          "claim_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "cwe": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}},
          "cited_lines": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "mechanism": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
