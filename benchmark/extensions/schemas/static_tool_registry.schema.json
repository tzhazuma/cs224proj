{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs224.local/benchmark/extensions/schemas/static_tool_registry.schema.json",
  "title": "Static analyzer rule registry",
  "description": "Pins rule-to-CWE mapping semantics for new static tools. Tool binaries/versions are recorded per run; this registry is versioned and must be frozen before test evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "tools"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "family",
          "version_probe",
          "command_template",
          "license",
          "default_scope",
          "status",
          "severity_policy",
          "rules",
          "allow_cwe_fallback"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "family": {"const": "static"},
          "version_probe": {"type": "string", "minLength": 1},
          "command_template": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "default_scope": {"enum": ["target_file", "target_function"]},
          "status": {"type": "string", "minLength": 1},
          "severity_policy": {
            "type": "object",
            "additionalProperties": true,
            "required": ["high", "medium", "low"],
            "properties": {
              "high": {"type": "array", "items": {"type": "string"}},
              "medium": {"type": "array", "items": {"type": "string"}},
              "low": {"type": "array", "items": {"type": "string"}}
            }
          },
          "rules": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cwe", "category", "counts_for_cwe401"],
              "properties": {
                "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
                "category": {"type": "string", "minLength": 1},
                "counts_for_cwe401": {"type": "boolean"}
              }
            }
          },
          "rule_prefixes": {"type": "array", "items": {"type": "string"}},
          "allow_cwe_fallback": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
