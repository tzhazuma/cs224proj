// L4 v3: derive CWE-401 leaks from LLM-extracted heap facts (schema: l4/SCHEMA.md).
// Flow-insensitive, Andersen-style inclusion points-to over (scope, variable) nodes. Every fact carries the
// line of its statement; facts on lines the model marks dead (never-executing branch) are dropped, and
// llmlane/l4.py has already dropped facts whose line does not hold the statement (grounding check).

.type Sym <: symbol

.decl alloc(o: Sym, v: Sym, f: Sym, l: number)
.decl realloc(o: Sym, d: Sym, s: Sym, f: Sym, l: number)
.decl free(v: Sym, f: Sym, l: number)
.decl assign(d: Sym, s: Sym, f: Sym, l: number)
.decl pass(callee: Sym, param: Sym, arg: Sym, f: Sym, l: number)
.decl retval(d: Sym, callee: Sym, f: Sym, l: number)
.decl ret(f: Sym, v: Sym, l: number)
.decl call(caller: Sym, callee: Sym, l: number)
.decl global(v: Sym)
.decl dead(l: number)
.input alloc, realloc, free, assign, pass, retval, ret, call, global, dead

// ---- functions executed from main -------------------------------------------------
.decl func(f: Sym)
func(f) :- alloc(_, _, f, _).
func(f) :- realloc(_, _, _, f, _).
func(f) :- free(_, f, _).
func(f) :- assign(_, _, f, _).
func(f) :- pass(_, _, _, f, _).
func(g) :- pass(g, _, _, _, _).
func(f) :- retval(_, _, f, _).
func(f) :- ret(f, _, _).
func(f) :- call(f, _, _).
func(g) :- call(_, g, _).

.decl has_main()
has_main() :- func("main").

.decl reach(f: Sym)
reach("main").
reach(g) :- reach(f), call(f, g, l), !dead(l).
reach(g) :- reach(f), pass(g, _, _, f, l), !dead(l).
reach(g) :- reach(f), retval(_, g, f, l), !dead(l).
// No main in the facts: treat every mentioned function as executed.
reach(f) :- func(f), !has_main().

// ---- variable nodes: globals and Class::member share one scope ------------------
.decl mention(f: Sym, v: Sym)
mention(f, v) :- alloc(_, v, f, _).
mention(f, v) :- realloc(_, v, _, f, _).
mention(f, v) :- realloc(_, _, v, f, _).
mention(f, v) :- free(v, f, _).
mention(f, v) :- assign(v, _, f, _).
mention(f, v) :- assign(_, v, f, _).
mention(f, v) :- pass(_, _, v, f, _).
mention(g, p) :- pass(g, p, _, _, _).
mention(f, v) :- retval(v, _, f, _).
mention(f, v) :- ret(f, v, _).

.decl scope(f: Sym, v: Sym, s: Sym)
scope(f, v, "@global") :- mention(f, v), global(v).
scope(f, v, "@global") :- mention(f, v), !global(v), contains("::", v).
scope(f, v, f) :- mention(f, v), !global(v), !contains("::", v).

// ---- points-to ------------------------------------------------------------------
.decl new_obj(o: Sym, v: Sym, f: Sym)
new_obj(o, v, f) :- alloc(o, v, f, l), reach(f), !dead(l).
new_obj(o, d, f) :- realloc(o, d, _, f, l), reach(f), !dead(l).

.decl pts(s: Sym, v: Sym, o: Sym)
pts(s, v, o) :- new_obj(o, v, f), scope(f, v, s).
pts(sd, d, o) :- assign(d, x, f, l), reach(f), !dead(l), scope(f, d, sd), scope(f, x, sx), pts(sx, x, o).
// Parameters alias their argument in both directions (out-parameters, references).
pts(sp, p, o) :- pass(g, p, a, f, l), reach(f), !dead(l), scope(f, a, sa), scope(g, p, sp), pts(sa, a, o).
pts(sa, a, o) :- pass(g, p, a, f, l), reach(f), !dead(l), scope(f, a, sa), scope(g, p, sp), pts(sp, p, o).
pts(sd, d, o) :- retval(d, g, f, l), reach(f), !dead(l), scope(f, d, sd),
                 ret(g, r, lr), !dead(lr), scope(g, r, sr), pts(sr, r, o).

// ---- leaks ----------------------------------------------------------------------
.decl freed(o: Sym)
freed(o) :- free(v, f, l), reach(f), !dead(l), scope(f, v, s), pts(s, v, o).
// A successful realloc releases the block its first argument points to.
freed(o) :- realloc(n, _, src, f, l), reach(f), !dead(l), scope(f, src, s), pts(s, src, o), o != n.

.decl leak(o: Sym, reason: Sym)
leak(o, "never_freed") :- new_obj(o, _, _), !freed(o).
// p = realloc(p, ...): when realloc fails, NULL overwrites the only pointer to the old block.
leak(o, "realloc_fail") :- realloc(n, v, v, f, l), reach(f), !dead(l), scope(f, v, s), pts(s, v, o), o != n.
.output leak
