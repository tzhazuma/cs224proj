# ---------------------------------------------------------------------------
# SecVulEval / Juliet repository — publication ignore rules
#
# Policy: keep frozen data cards, result JSONL/JSON, reports and runnable
# scripts.  Do NOT commit upstream archives, extracted Juliet raw sources,
# per-case compiled binaries, request caches or credentials.
# ---------------------------------------------------------------------------

# Python bytecode and local tooling caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
.idea/
*.tmp
*.bak
*.orig
*.sqlite
*.sqlite3
*.sqlite-*

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
~$*

# Credentials and authentication material (never commit these)
.env
.env.*
!.env.example
creds/
credentials/
secrets/
*.pem
*.crt
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
auth.json
opencode.json
*_api_key.json
*.token

# Blind-review key: withheld so the LLM-assisted ratings cannot be unblinded
# from the public repository.  The published summaries stay in
# repair_eval/analysis/repair_blind_v1/final/.
repair_eval/packages/*/private/

# Juliet upstream archive, extracted raw tree, and local binaries.
# Restore with: python3 juliet/scripts/fetch_juliet.py
juliet/cache/
juliet/raw/
juliet/build/

# Traditional dynamic per-case binaries and logs (326 MB, regenerable).
# Keep cases.jsonl, results.jsonl, metrics.json/md, manifest.json and run.log.
traditional/dynamic/runs/*/cases/
traditional/dynamic/runs/*/support/

# Juliet repair harness build products.  Keep baselines_summary.json/.md and
# selftest.json; the per-unit baseline logs can be regenerated by
# scripts/check_baselines.py.
juliet_repair/build/baselines/
juliet_repair/build/sanitized/
juliet_repair/build/support/
juliet_repair/build/selftest/

# Per-request caches created by the runner and the API experiment runners.
# They duplicate requests.jsonl / results.jsonl and are safe to drop.
**/runs/*/cache/

# TeX / build intermediates (PDFs and .tex sources stay tracked)
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot

# NOTE: juliet_llm/build/ is deliberately NOT ignored.  It contains the
# generated dev/test prompt inputs and the leakage audit, which are inputs to
# the reported LLM runs rather than compiled binaries.
